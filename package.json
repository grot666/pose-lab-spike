{
  "name": "pose-lab-spike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-only MediaPipe Pose Landmarker spike: in-browser realtime pose detection, judging, visualization and measurement.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fetch-models": "node scripts/fetch-models.mjs",
    "check-assets": "node scripts/check-assets.mjs",
    "predev": "node scripts/check-assets.mjs",
    "prebuild": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
